# Configuracao do Banco de Dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=parseapp
# Em desenvolvimento local fora do docker: localhost:5432
# Dentro da rede docker-compose: postgres:5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/parseapp

# Configuracao de Seguranca / JWT
SECRET_KEY=sua-chave-secreta-super-segura-troque-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Configuracao de Upload e Processamento Efemero
UPLOAD_DIR=/tmp/uploads/parseapp
MAX_UPLOAD_SIZE_MB=20
MAX_ERROS_VALIDACAO_DIARIO=10

# Autenticacao Google OAuth 2.0 (Opcional em dev local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Integracao de Pagamentos e Assinaturas Asaas (API v3)
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=parseapp-asaas-webhook-secret
