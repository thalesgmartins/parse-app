# Configuracao do Banco de Dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=parseapp
# Em desenvolvimento local fora do docker: localhost:5432
# Dentro da rede docker-compose: postgres:5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/parseapp

# Configuracao de Seguranca / JWT
SECRET_KEY=sua-chave-secreta-super-segura-troque-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# (Legado - a ser removido na conclusao da Fase 2)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
