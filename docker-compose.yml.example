# |  ___/ _` | '__/ __|/ _ \ / /\ \ | '_ \| '_ \
# | |  | (_| | |  \__ \  __// ____ \| |_) | |_) |
# |_|   \__,_|_|  |___/\___/_/    \_\ .__/| .__/
#                                   | |   | |
services:
  parse-app:
    image: ghcr.io/thalesgmartins/parse-app:latest
    container_name: parse-app
    ports:
      - "8000:8000"
    env_file: ".env"
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  postgres:
    image: postgres:16-alpine
    container_name: parse-postgres
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
      POSTGRES_DB: ${POSTGRES_DB:-parseapp}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-parseapp}"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped

volumes:
  postgres_data:
